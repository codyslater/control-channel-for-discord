{
  "name": "control-channel-for-discord",
  "displayName": "Control Channel for Discord",
  "description": "Chat in your Discord server from inside VS Code — live channels, threads, an activity feed, and clickable code references",
  "publisher": "c0d3s",
  "version": "1.0.1",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0b7c71",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/codyslater/control-channel-for-discord"
  },
  "homepage": "https://github.com/codyslater/control-channel-for-discord#readme",
  "bugs": {
    "url": "https://github.com/codyslater/control-channel-for-discord/issues"
  },
  "keywords": [
    "discord",
    "chat",
    "bots",
    "productivity",
    "collaboration"
  ],
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other",
    "Chat"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "discordVscodeDock",
          "title": "Discord Chat",
          "icon": "media/icon.svg"
        }
      ],
      "activitybar": [
        {
          "id": "discordVscode",
          "title": "Discord",
          "icon": "media/icon.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "discordVscodeDockRight",
          "title": "Discord Chat",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "discordVscode": [
        {
          "id": "discordVscode.activity",
          "name": "Activity",
          "initialSize": 1
        },
        {
          "id": "discordVscode.channels",
          "name": "Channels",
          "initialSize": 15
        },
        {
          "id": "discordVscode.chat",
          "type": "webview",
          "name": "Chat",
          "when": "discordVscode.chatOpened",
          "initialSize": 16
        }
      ],
      "discordVscodeDock": [
        {
          "id": "discordVscode.dockBottom",
          "type": "webview",
          "name": "Chat Dock"
        }
      ],
      "discordVscodeDockRight": [
        {
          "id": "discordVscode.dockRight",
          "type": "webview",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "discordVscode.setToken",
        "title": "Discord: Set Bot Token"
      },
      {
        "command": "discordVscode.reconnect",
        "title": "Discord: Reconnect"
      },
      {
        "command": "discordVscode.shareContext",
        "title": "Discord: Share Current Location"
      },
      {
        "command": "discordVscode.openWorktreeForBranch",
        "title": "Discord: Check Out / Open Worktree for Branch…"
      },
      {
        "command": "discordVscode.popOutChannel",
        "title": "Pop Out Chat",
        "category": "Discord",
        "icon": "$(multiple-windows)"
      },
      {
        "command": "discordVscode.popOutCurrent",
        "title": "Pop Out Current Channel",
        "category": "Discord",
        "icon": "$(multiple-windows)"
      },
      {
        "command": "discordVscode.popOutCurrentBeside",
        "title": "Pop Out Current Channel Beside",
        "category": "Discord"
      },
      {
        "command": "discordVscode.popOutCurrentBelow",
        "title": "Pop Out Current Channel Below",
        "category": "Discord"
      },
      {
        "command": "discordVscode.openInBottomDock",
        "title": "Open in Bottom Dock",
        "category": "Discord",
        "icon": "$(layout-panel)"
      },
      {
        "command": "discordVscode.openInRightDock",
        "title": "Open in Right Dock",
        "category": "Discord",
        "icon": "$(layout-sidebar-right)"
      },
      {
        "command": "discordVscode.openChannel",
        "title": "Open in Sidebar Chat",
        "category": "Discord",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "discordVscode.clearSidebarChat",
        "title": "Clear and Hide Sidebar Chat",
        "category": "Discord",
        "icon": "$(clear-all)"
      },
      {
        "command": "discordVscode.sendCurrentToBottomDock",
        "title": "Send Current Channel to Bottom Dock",
        "category": "Discord",
        "icon": "$(layout-panel)"
      },
      {
        "command": "discordVscode.sendCurrentToRightDock",
        "title": "Send Current Channel to Right Dock",
        "category": "Discord",
        "icon": "$(layout-sidebar-right)"
      },
      {
        "command": "discordVscode.pinChannel",
        "title": "Pin",
        "category": "Discord"
      },
      {
        "command": "discordVscode.unpinChannel",
        "title": "Unpin",
        "category": "Discord"
      },
      {
        "command": "discordVscode.silenceChannel",
        "title": "Silence (no Activity)",
        "category": "Discord"
      },
      {
        "command": "discordVscode.unsilenceChannel",
        "title": "Unsilence",
        "category": "Discord"
      },
      {
        "command": "discordVscode.openFromActivity",
        "title": "Open from Activity",
        "category": "Discord"
      }
    ],
    "menus": {
      "webview/context": [
        {
          "command": "discordVscode.openWorktreeForBranch",
          "when": "webviewId =~ /^discordVscode\\.(chat(Panel)?|dockBottom|dockRight)$/ && webviewSection == 'message'"
        }
      ],
      "view/item/context": [
        {
          "command": "discordVscode.openInRightDock",
          "when": "view == discordVscode.channels && viewItem =~ /^(text|thread)(-silenced)?$/ && config.discordVscode.treeButtonTarget == 'right'",
          "group": "inline"
        },
        {
          "command": "discordVscode.openInBottomDock",
          "when": "view == discordVscode.channels && viewItem =~ /^(text|thread)(-silenced)?$/ && config.discordVscode.treeButtonTarget == 'bottom'",
          "group": "inline"
        },
        {
          "command": "discordVscode.openChannel",
          "when": "view == discordVscode.channels && viewItem =~ /^(text|thread)(-silenced)?$/ && config.discordVscode.treeButtonTarget == 'sidebar'",
          "group": "inline"
        },
        {
          "command": "discordVscode.popOutChannel",
          "when": "view == discordVscode.channels && viewItem =~ /^(text|thread)(-silenced)?$/ && config.discordVscode.treeButtonTarget == 'popOut'",
          "group": "inline"
        },
        {
          "command": "discordVscode.openInRightDock",
          "when": "view == discordVscode.activity && viewItem =~ /^activity-(text|thread)$/ && config.discordVscode.treeButtonTarget == 'right'",
          "group": "inline"
        },
        {
          "command": "discordVscode.openInBottomDock",
          "when": "view == discordVscode.activity && viewItem =~ /^activity-(text|thread)$/ && config.discordVscode.treeButtonTarget == 'bottom'",
          "group": "inline"
        },
        {
          "command": "discordVscode.openChannel",
          "when": "view == discordVscode.activity && viewItem =~ /^activity-(text|thread)$/ && config.discordVscode.treeButtonTarget == 'sidebar'",
          "group": "inline"
        },
        {
          "command": "discordVscode.popOutChannel",
          "when": "view == discordVscode.activity && viewItem =~ /^activity-(text|thread)$/ && config.discordVscode.treeButtonTarget == 'popOut'",
          "group": "inline"
        },
        {
          "command": "discordVscode.openInBottomDock",
          "when": "view == discordVscode.activity && viewItem =~ /^activity-(text|thread)$/"
        },
        {
          "command": "discordVscode.openInRightDock",
          "when": "view == discordVscode.activity && viewItem =~ /^activity-(text|thread)$/"
        },
        {
          "command": "discordVscode.pinChannel",
          "when": "view == discordVscode.activity && viewItem =~ /^activity-(text|thread)$/"
        },
        {
          "command": "discordVscode.silenceChannel",
          "when": "view == discordVscode.activity && viewItem =~ /^activity-(text|thread)$/"
        },
        {
          "command": "discordVscode.openInBottomDock",
          "when": "view == discordVscode.channels && viewItem =~ /^(text|thread)(-silenced)?$/"
        },
        {
          "command": "discordVscode.openInRightDock",
          "when": "view == discordVscode.channels && viewItem =~ /^(text|thread)(-silenced)?$/"
        },
        {
          "command": "discordVscode.pinChannel",
          "when": "view == discordVscode.channels && viewItem =~ /^(text|thread)(-silenced)?$/"
        },
        {
          "command": "discordVscode.unpinChannel",
          "when": "view == discordVscode.channels && viewItem =~ /^pin-(text|thread)$/"
        },
        {
          "command": "discordVscode.silenceChannel",
          "when": "view == discordVscode.channels && viewItem =~ /^(text|thread)$/"
        },
        {
          "command": "discordVscode.unsilenceChannel",
          "when": "view == discordVscode.channels && viewItem =~ /^(text|thread)-silenced$/"
        }
      ],
      "view/title": [
        {
          "command": "discordVscode.clearSidebarChat",
          "when": "view == discordVscode.chat",
          "group": "navigation@0"
        },
        {
          "command": "discordVscode.popOutCurrent",
          "when": "view == discordVscode.chat",
          "group": "navigation"
        },
        {
          "command": "discordVscode.sendCurrentToBottomDock",
          "when": "view == discordVscode.chat",
          "group": "navigation@2"
        },
        {
          "command": "discordVscode.sendCurrentToRightDock",
          "when": "view == discordVscode.chat",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "discordVscode.popOutChannel",
          "when": "false"
        },
        {
          "command": "discordVscode.openInBottomDock",
          "when": "false"
        },
        {
          "command": "discordVscode.openInRightDock",
          "when": "false"
        },
        {
          "command": "discordVscode.openChannel",
          "when": "false"
        },
        {
          "command": "discordVscode.pinChannel",
          "when": "false"
        },
        {
          "command": "discordVscode.unpinChannel",
          "when": "false"
        },
        {
          "command": "discordVscode.silenceChannel",
          "when": "false"
        },
        {
          "command": "discordVscode.unsilenceChannel",
          "when": "false"
        },
        {
          "command": "discordVscode.openFromActivity",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Control Channel for Discord",
      "properties": {
        "discordVscode.guildId": {
          "type": "string",
          "default": "",
          "description": "Discord server (guild) ID. Auto-detected on first connect if the bot is in exactly one guild."
        },
        "discordVscode.userId": {
          "type": "string",
          "default": "",
          "description": "Your Discord user ID — used to send webhook messages with your name and avatar."
        },
        "discordVscode.hostName": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Override this machine's name for deep-link matching and context sharing (defaults to OS hostname)."
        },
        "discordVscode.hostAliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine",
          "description": "Additional names this machine answers to in deep links."
        },
        "discordVscode.hiddenChannels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Channel names to hide from the tree."
        },
        "discordVscode.pinnedChannels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Channel/thread IDs pinned to the 📌 section at the top of the tree (synced)."
        },
        "discordVscode.silencedChannels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Channel/thread IDs excluded from the Activity view (synced). Everything else about them is unchanged."
        },
        "discordVscode.popOutPlacement": {
          "type": "string",
          "enum": [
            "beside",
            "active",
            "below"
          ],
          "default": "beside",
          "description": "Which editor group a pop-out chat opens into: beside the active group, inside it, or in a group below it."
        },
        "discordVscode.treeButtonTarget": {
          "type": "string",
          "enum": [
            "right",
            "bottom",
            "sidebar",
            "popOut"
          ],
          "enumDescriptions": [
            "Open in the right dock (Secondary Side Bar)",
            "Open in the bottom dock (Panel, next to Terminal)",
            "Open in the sidebar Chat view",
            "Pop out into an editor tab"
          ],
          "default": "right",
          "description": "Where the inline button next to a channel/thread in the tree opens it. Clicking the row itself always opens the sidebar Chat view."
        },
        "discordVscode.activityWindowMinutes": {
          "type": "number",
          "minimum": 0,
          "default": 15,
          "description": "Activity shows channels/threads active within this many minutes; entries that are unread or mention you always stay. 0 = no time limit."
        },
        "discordVscode.trustTunnelLinks": {
          "type": "boolean",
          "default": false,
          "description": "Connect to a tunnel named in a deep link without asking first. Leave off unless you trust everyone who can post links in your server (e.g. a private server with only your own bots) — a malicious link could otherwise open a folder on a tunnel you own."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run typecheck && npm test && npm run build",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "discord.js": "^14.16.0",
    "dompurify": "^3.4.14",
    "highlight.js": "^11.10.0",
    "marked": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.106.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
